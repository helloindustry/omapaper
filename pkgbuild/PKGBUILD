pkgname=taskpaper
pkgver=0.1.0
pkgrel=1
pkgdesc='A plain-text task outliner in the style of TaskPaper'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'xdg-desktop-portal')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/taskpaper "$pkgdir/usr/bin/taskpaper"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/taskpaper.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/taskpaper.svg"
  install -Dm644 "$startdir/taskpaper.desktop" "$pkgdir/usr/share/applications/taskpaper.desktop"
}
